# ==============================
# Smart Study AI - Environment
# ==============================

# Core AI: only one provider is required to start.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Optional fallback providers. Add these only if you want automatic failover.
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_VISION_MODEL=
GROQ_VISION_MODEL=
AI_FALLBACK_PROVIDERS=gemini,openai,groq
AI_MAX_RETRIES=1
MAX_AGENT_CALLS=3
MAX_RAG_SOURCES=8

# Optional per-slot overrides. Leave blank to use GEMINI_MODEL consistently.
ROUTER_PROVIDER=
ROUTER_MODEL=
RESEARCHER_PROVIDER=
RESEARCHER_MODEL=
TEACHER_PROVIDER=
TEACHER_MODEL=
REASONER_PROVIDER=
REASONER_MODEL=
CRITIC_PROVIDER=
CRITIC_MODEL=
SYNTHESIZER_PROVIDER=
SYNTHESIZER_MODEL=

# Learning system: required for login, user data, quizzes and progress.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret

# Optional Qdrant vector database. Local JSON remains the development fallback.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=smart_study_knowledge

# Session/security
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5050,http://127.0.0.1:5050
ALLOW_FILE_ORIGIN=false
PORT=5050
NODE_ENV=development

# Google Gmail + Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/google/callback

# Optional YouTube educational video cards
YOUTUBE_API_KEY=

# Cost-aware model routing (uses provider/model pricing estimates and actual usage metadata when available)
AI_COST_AWARE_ROUTING=true
AI_BUDGET_USD_PER_SESSION=0.25
AI_HARD_BUDGET=true
GEMINI_INPUT_USD_PER_1K=0.0002
GEMINI_OUTPUT_USD_PER_1K=0.0008
OPENAI_INPUT_USD_PER_1K=0.001
OPENAI_OUTPUT_USD_PER_1K=0.004
GROQ_INPUT_USD_PER_1K=0.0002
GROQ_OUTPUT_USD_PER_1K=0.0006

# Local password-reset demo. Never expose reset tokens in production.
ALLOW_DEV_RESET_TOKEN=false
RESEND_API_KEY=
PASSWORD_RESET_FROM=Smart Study AI <no-reply@example.com>
PASSWORD_RESET_URL=http://localhost:5050

# Optional local code runner. Keep false on public deployments unless a hardened sandbox is used.
ENABLE_CODE_EXECUTION=false
CODE_EXECUTION_MODE=docker
ALLOW_UNSANDBOXED_CODE=false
CODE_NODE_IMAGE=node:22-alpine
CODE_PYTHON_IMAGE=python:3.12-alpine
CODE_CPP_IMAGE=gcc:14
CODE_CPU_LIMIT=0.5
CODE_MEMORY_LIMIT=256m
CODE_PIDS_LIMIT=64
PYTHON_BIN=python3

# Optional external educational video generation provider
VIDEO_API_URL=
VIDEO_API_KEY=

# Document archive/conversion resource limits
DOCUMENT_MAX_ARCHIVE_ENTRIES=500
DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
DOCUMENT_ARCHIVE_TIMEOUT_MS=5000
DOCUMENT_CONVERSION_TIMEOUT_MS=15000
